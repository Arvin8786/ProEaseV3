{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Professional profile and career data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "website": { "type": "string" },
        "professionalSummary": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "experience": { "type": "array" },
        "education": { "type": "array" },
        "references": { "type": "array" },
        "languages": { "type": "array" },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "isAdmin": { "type": "boolean" },
        "subscriptionExpiry": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "plan"]
    },
    "AdminConfig": {
      "title": "Admin Configuration",
      "description": "Global settings for the application",
      "type": "object",
      "properties": {
        "passwordHash": { "type": "string" },
        "features": { "type": "object" },
        "planLimits": { "type": "object" }
      }
    },
    "GeneratedDocument": {
      "title": "Generated Document",
      "description": "A document generated by the AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "params": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ScheduledMessage": {
      "title": "Scheduled Message",
      "description": "A message scheduled to be sent via WhatsApp",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "message": { "type": "string" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "sent", "cancelled"] },
        "docId": { "type": "string" },
        "docType": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "recipientPhone", "message", "scheduledAt", "status", "createdAt"]
    },
    "DocumentRequest": {
      "title": "Document Request / Transaction",
      "description": "Per-document request with unique transaction ID, payment status, and admin approval queue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "transactionId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "docType": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_approval", "approved", "rejected"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "verified"] },
        "paymentProofRef": { "type": "string" },
        "paymentProofUrl": { "type": "string" },
        "draftContent": { "type": "string" },
        "params": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["transactionId", "userId", "userEmail", "docType", "title", "amount", "status"]
    },
    "UploadedDocument": {
      "title": "Uploaded Career Document",
      "description": "User uploaded important document like offer letter, payslip, contract, cert",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string", "enum": ["offer_letter", "payslip", "employment_contract", "resignation_acceptance", "education_cert", "tax_ea_form", "other"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "fileType": { "type": "string" },
        "fileData": { "type": "string" },
        "companyName": { "type": "string" },
        "issueDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "category", "title", "fileName", "fileData", "createdAt"]
    }
  },
  "firestore": {
    "/document_requests/{requestId}": {
      "schema": "DocumentRequest",
      "description": "User document requests, payment transactions, and admin approval queue"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Main user document"
    },
    "/users/{userId}/uploaded_documents/{docId}": {
      "schema": "UploadedDocument",
      "description": "Uploaded documents including offer letters, payslips, contracts, certs"
    },
    "/users/{userId}/generated_documents/{docId}": {
      "schema": "GeneratedDocument",
      "description": "History of documents generated by the user"
    },
    "/users/{userId}/scheduled_messages/{msgId}": {
      "schema": "ScheduledMessage",
      "description": "Messages scheduled for prospect employers"
    },
    "/admin_config/global": {
      "schema": "AdminConfig",
      "description": "Global application settings"
    },
    "/api_keys/{keyId}": {
      "schema": {
        "title": "API Key",
        "type": "object",
        "properties": {
          "key": { "type": "string" }
        }
      },
      "description": "Rotation pool for AI API keys"
    }
  }
}
